{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NewOutlookPatcher.exe",
            "detail": "Builds the worker DLL and the GUI into x64\\Release\\publish\\NewOutlookPatcher.exe",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        }
    ]
}
